---
import SectionHeading from '@/components/SectionHeading.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { services } from '@/data/services';
---

<section class="section section--alt" aria-labelledby="services-h">
  <div class="container services">
    <SectionHeading title="Services" id="services-h">
      <p>
        Power, safety, security and connectivity, handled by one team from design through to
        testing.
      </p>
    </SectionHeading>
    <ul class="services__grid" role="list">
      {services.map((service) => <li><ServiceCard service={service} /></li>)}
    </ul>
  </div>
</section>

<style>
  .services {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
  }
  @media (max-width: 1000px) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
