---
import CircuitTraces from '@/components/CircuitTraces.astro';
import Icon from '@/components/Icon.astro';
---

<section class="hero">
  <CircuitTraces variant="hero" class="hero__traces" />
  <div class="container hero__inner">
    <div class="hero__eyebrow label">
      <span class="hero__dot" aria-hidden="true"></span>
      Electrical engineering / UK wide
    </div>
    <h1 class="display h1">Innovation in electrical engineering<span class="hero__stop">.</span></h1>
    <p class="hero__lead">
      Design, installation, commissioning and maintenance for industrial, commercial and domestic
      projects across the UK.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/projects/">View our projects <Icon name="arrow" size={18} strokeWidth={2} /></a>
      <a class="btn btn--ghost" href="/contact/">Contact us</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(43.75rem, 86vh);
    padding-block: 5rem;
    background-image:
      linear-gradient(var(--blue-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--blue-faint) 1px, transparent 1px);
    background-size: 48px 48px;
  }
  .hero :global(.hero__traces) {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    max-width: none;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--blue);
  }
  .hero h1 {
    max-width: 44rem;
  }
  .hero__stop {
    color: var(--blue);
  }
  .hero__lead {
    max-width: 35rem;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  /* Below desktop the traces sit behind the copy, so fade them right back. */
  @media (max-width: 1100px) {
    .hero :global(.hero__traces) {
      opacity: 0.22;
    }
  }
</style>
