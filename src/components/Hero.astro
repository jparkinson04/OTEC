---
import CircuitTraces from '@/components/CircuitTraces.astro';
import Icon from '@/components/Icon.astro';
---

<section class="hero ambient">
  <CircuitTraces variant="hero" class="hero__traces" />
  <div class="container hero__inner">
    <h1 class="display h1">Home to innovation in electrical engineering<span class="hero__stop">.</span></h1>
    <p class="hero__lead">
      Electrical design, installation, commissioning and maintenance, UK wide.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/projects/">View our projects <Icon name="arrow" size={18} strokeWidth={2} /></a>
      <a class="btn btn--ghost" href="/contact/">Contact us</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(43.75rem, 86vh);
    padding-block: 5rem;
  }
  .hero :global(.hero__traces) {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    width: auto;
    max-width: none;
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
  }
  .hero h1 {
    max-width: 44rem;
    /* A step below --fs-h1 (30 -> 68px) so the uppercase headline breaks into even lines
       and "ENGINEERING." still fits a 320px screen. */
    font-size: clamp(1.875rem, 0.9rem + 4.5vw, 4.25rem);
    text-wrap: balance;
  }
  .hero__stop {
    color: var(--blue);
  }
  .hero__lead {
    max-width: 32rem;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  /* Below desktop the traces sit behind the copy, so fade them right back. */
  @media (max-width: 1100px) {
    .hero :global(.hero__traces) {
      opacity: 0.22;
    }
  }
</style>
