---
const items = [
  { label: 'Coverage', value: 'UK wide' },
  { label: 'Sectors', value: 'Public and private' },
  { label: 'Projects', value: 'Industrial, commercial, domestic' },
];
---

<section class="glance" aria-label="At a glance">
  <dl class="container glance__grid">
    {
      items.map((item) => (
        <div class="glance__item">
          <dt class="label label--dim">{item.label}</dt>
          <dd class="display glance__value">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .glance {
    background: var(--bg-alt);
    border-block: 1px solid var(--line);
  }
  .glance__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-block: 0;
  }
  .glance__item {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 2.25rem 2.5rem;
    border-left: 1px solid var(--line);
  }
  .glance__item:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .glance__value {
    margin: 0;
    font-size: 1.375rem;
    letter-spacing: 0;
    line-height: 1.25;
    color: var(--text);
  }

  @media (max-width: 860px) {
    .glance__grid {
      grid-template-columns: 1fr;
    }
    .glance__item {
      padding: 1.5rem 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .glance__item:first-child {
      border-top: 0;
    }
  }
</style>
