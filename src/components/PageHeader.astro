---
// Top-of-page band for inner pages (Projects, Contact). Shares the hero's ambient glow.
interface Props {
  label: string;
  title: string;
  /** On phones, drop the intro so the page content starts sooner (used on Contact). */
  compact?: boolean;
}
const { label, title, compact = false } = Astro.props;
---

<section class:list={['page-header ambient', { 'page-header--compact': compact }]}>
  <div class="container page-header__inner">
    <span class="label">{label}</span>
    <h1 class="display h2-lg">{title}</h1>
    {Astro.slots.has('default') && <p class="muted"><slot /></p>}
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--line);
    --glow-at: 90% 50%;
  }
  .page-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .page-header p {
    max-width: 38rem;
    font-size: var(--fs-lead);
  }
  @media (max-width: 640px) {
    .page-header {
      padding-block: 2rem;
    }
    .page-header__inner {
      gap: 0.75rem;
    }
    .page-header--compact {
      padding-block: 1.25rem;
    }
    .page-header--compact .page-header__inner {
      gap: 0.5rem;
    }
    .page-header--compact p {
      display: none;
    }
    /* Small enough for a short title to stay on one line at 360px and up. */
    .page-header--compact h1 {
      font-size: clamp(1rem, 4.6vw, 1.25rem);
    }
  }
</style>
