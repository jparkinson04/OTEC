---
// Top-of-page band for inner pages (Projects, Contact). Shares the hero's ambient glow.
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;
---

<section class="page-header ambient">
  <div class="container page-header__inner">
    <span class="label">{label}</span>
    <h1 class="display h2-lg">{title}</h1>
    {Astro.slots.has('default') && <p class="muted"><slot /></p>}
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-bottom: 1px solid var(--line);
    --glow-at: 90% 50%;
  }
  .page-header__inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .page-header p {
    max-width: 38rem;
    font-size: var(--fs-lead);
  }
</style>
