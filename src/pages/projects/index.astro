---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectMap from '@/components/ProjectMap.astro';
import CtaBand from '@/components/CtaBand.astro';
---

<BaseLayout
  title="Projects"
  description="Electrical engineering projects completed by OTEC across the UK."
>
  <PageHeader label="Projects" title="Our work, across the UK.">
    Hover a pin to preview a project, or click through for photos and a short write-up.
  </PageHeader>

  <section class="section">
    <div class="container">
      <ProjectMap />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
