---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import CtaBand from '@/components/CtaBand.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<BaseLayout
  title="Projects"
  description="Electrical engineering projects completed by OTEC across the UK."
>
  <PageHeader label="Projects" title="Our work, across the UK.">
    Hover a pin to preview a project, or click through for photos and a short write-up.
  </PageHeader>

  <section class="section">
    <div class="container stack">
      <!--
        MAP SLOT: replaced by <ProjectMap /> in prompts/02-projects-map.md.
        The grid below stays as the accessible / no-JS / mobile fallback.
      -->
      <div class="map-slot placeholder">[Interactive project map]</div>

      <ul class="grid" role="list">
        {projects.map((project) => <li><ProjectCard project={project} /></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .map-slot {
    min-height: clamp(22rem, 60vh, 40rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem 1.5rem;
    margin: 0;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
